# Copiar este archivo como .env y completar los valores
PORT=3000
MONGO_URI=mongodb://localhost:27017/aldia

# Debe ser EXACTAMENTE la misma JWT_SECRET que en la API de Django
JWT_SECRET=cambiar-por-otra-clave-larga-y-aleatoria
JWT_EXPIRATION=8h
JWT_ISSUER=aldia-auth

# Clave compartida para que Node y Django se hablen entre servidores
API_KEY_INTERNA=cambiar-por-una-clave-interna
DJANGO_API_URL=http://localhost:8000

# Orígenes permitidos por CORS y Socket.IO (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Opcional: IA con Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Cada cuántos minutos se revisan los cobros para generar notificaciones
MINUTOS_REVISION_COBROS=60

# Opcional: puente con Firebase Realtime Database (ruta al JSON de la cuenta de servicio y URL)
FIREBASE_KEY_PATH=
FIREBASE_DATABASE_URL=
