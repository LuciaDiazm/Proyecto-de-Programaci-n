  "item": [
    {
      "name": "1. Autenticación (Node)",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{node}}/api/auth/registro",
              "host": [
                "{{node}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Marianela\",\n  \"email\": \"mari@test.com\",\n  \"password\": \"Clave1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "if (datos.token) { pm.collectionVariables.set('token', datos.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{node}}/api/auth/login",
              "host": [
                "{{node}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mari@test.com\",\n  \"password\": \"Clave1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "if (datos.token) { pm.collectionVariables.set('token', datos.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{node}}/api/auth/perfil",
              "host": [
                "{{node}}"
              ],
              "path": [
                "api",
                "auth",
                "perfil"
              ]
            }
          }
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{node}}/api/auth/perfil",
              "host": [
                "{{node}}"
              ],
              "path": [
                "api",
                "auth",
                "perfil"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diasAviso\": 5\n}"
            }
