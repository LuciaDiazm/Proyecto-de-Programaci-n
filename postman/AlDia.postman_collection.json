    {
      "name": "8. Cuentas de Django (simplejwt)",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/register/",
              "host": [
                "{{django}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"email\": \"ana@test.com\",\n  \"password\": \"Clave12345!\"\n}"
            }
          }
        },
        {
          "name": "Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/token/",
              "host": [
                "{{django}}"
              ],
              "path": [
                "api",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"Clave12345!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "if (datos.access !== undefined) { pm.collectionVariables.set('token', datos.access); }",
                  "if (datos.refresh !== undefined) { pm.collectionVariables.set('refreshDjango', datos.refresh); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/token/refresh/",
              "host": [
                "{{django}}"
              ],
              "path": [
                "api",
                "token",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshDjango}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "if (datos.access !== undefined) { pm.collectionVariables.set('token', datos.access); }",
                  "if (datos.refresh !== undefined) { pm.collectionVariables.set('refreshDjango', datos.refresh); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Blacklist (logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/token/blacklist/",
              "host": [
                "{{django}}"
              ],
              "path": [
                "api",
                "token",
                "blacklist"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshDjango}}\"\n}"
            }
          }
        }
      ]
    },
