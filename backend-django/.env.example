# Copiar este archivo como .env y completar los valores

DEBUG=True
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: sqlite (por defecto), postgresql o mysql
DB_ENGINE=sqlite
# Solo si DB_ENGINE no es sqlite:
# DB_NAME=aldia
# DB_USER=aldia
# DB_PASSWORD=aldia123
# DB_HOST=localhost
# DB_PORT=5432

# Debe ser EXACTAMENTE la misma JWT_SECRET que en la API de Node
JWT_SECRET=cambiar-por-otra-clave-larga-y-aleatoria
JWT_ISSUER=aldia-auth

# Clave compartida para que Node y Django se hablen entre servidores
API_KEY_INTERNA=cambiar-por-una-clave-interna
NODE_API_URL=http://localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Solo al desplegar con HTTPS, por ejemplo https://aldia.onrender.com
CSRF_TRUSTED_ORIGINS=

# Tiempo real: sin REDIS_URL se usa la memoria del proceso (alcanza en desarrollo)
# REDIS_URL=redis://127.0.0.1:6379

# Login con Google (opcional): se obtienen en la Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
